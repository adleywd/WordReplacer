@using MudBlazor
@inject AppSettings AppSettings

@if (_uiVersion is not null)
{
    <MudText Class="@Class" Typo="Typo.body2">v@(_uiVersion)</MudText>
}

@code {
    [Parameter] public string? Class { get; set; }
    
    private string? _uiVersion;
    
    protected override void OnInitialized()
    {
        _uiVersion = AppSettings.AppVersion;
    }
}
